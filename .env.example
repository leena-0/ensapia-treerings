# 이 파일을 .env 로 복사하고 실제 값을 채워 넣으세요. .env 는 git에 커밋되지 않습니다.
SLACK_BOT_TOKEN=xoxb-...

# LLM 1차 프로바이더 기본값은 gemini -- 무료 티어(일일 요청 20건 한도) 내에서 사용.
GEMINI_API_KEY=...
# LLM_PROVIDER=gemini            (기본값이라 생략 가능. 굳이 명시해도 무방)
# GEMINI_MODEL=gemini/gemini-flash-latest
# GEMINI_MIN_INTERVAL_SEC=4.5

# Gemini 무료 한도(일일 20건)를 넘었고 이미 다른 LLM API 키가 있다면, 코드 수정 없이
# 그걸로 그대로 전환할 수 있다. LLM_MODEL에 litellm이 인식하는 모델 문자열만 넣으면 됨
# (예: openai/gpt-4o-mini, anthropic/claude-3-5-haiku-20241022). LLM_API_KEY는 생략 가능 --
# 생략하면 litellm이 그 프로바이더의 표준 키 환경변수(OPENAI_API_KEY 등)를 알아서 찾는다.
# LLM_PROVIDER=openai             (gemini/upstage가 아닌 아무 이름이나 가능, 구분용)
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=...                 (표준 환경변수를 이미 따로 설정했다면 생략 가능)
# LLM_API_BASE=...                (자체 호스팅/커스텀 엔드포인트일 때만)
# LLM_MIN_INTERVAL_SEC=0

# upstage로 바꾸고 싶을 때만 필요 (LLM_PROVIDER=upstage 로 명시해야 실제로 적용됨)
# LLM_PROVIDER=upstage
# UPSTAGE_API_KEY=...
# UPSTAGE_MODEL=solar-pro3       (Solar Pro 2는 solar-pro2)
# UPSTAGE_API_BASE=https://api.upstage.ai/v1
# UPSTAGE_MIN_INTERVAL_SEC=0

# 선택 사항 (기본값 있음)
# ENABLE_LOCAL_FALLBACK=false
# LOCAL_LLM_MODEL=ollama/llama3.1
# SLACK_INGEST_CHANNEL_ID=C0BJH7F2FC4
# PDF_FONT_PATH=/path/to/NotoSansKR-Regular.ttf

# 개인 Slack 매핑 (선택) — 코칭 카드/주간 리포트를 본인 Slack DM으로 받아보고 싶을 때만 채움.
# data/slack_user_map.json·slack_display_names.json 에는 커밋하지 않고 여기서만 오버라이드된다.
# SLACK_MY_USER_ID=U0...           (Slack 프로필 > ⋮ 더보기 > "멤버 ID 복사")
# SLACK_MY_MEMBER_ID=M01           (받아볼 목데이터 멤버 — 보통 팀 리더/1차평가자)
# SLACK_MY_DISPLAY_NAME=본인 이름
